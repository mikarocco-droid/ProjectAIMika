# Dockerfile.runpod — ScoutIA Worker GPU (RunPod RTX 4090)
# Pour web app CPU : voir Dockerfile
# ═══════════════════════════════════════════════════════
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dépendances système + Python 3.11
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    git \
    ffmpeg \
    tesseract-ocr \
    tesseract-ocr-fra \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    wget \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Python 3.11 par défaut
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python python3.11 1 \
    && python3 -m pip install --upgrade pip

# PyTorch CUDA + dépendances GPU
RUN pip install \
    torch torchvision --index-url https://download.pytorch.org/whl/cu121 \
    && pip install \
    rfdetr \
    opencv-python-headless \
    anthropic \
    fpdf2 \
    python-dotenv \
    scikit-learn \
    joblib \
    numpy \
    google-genai \
    av \
    pytesseract \
    boto3 \
    deep-sort-realtime \
    torchreid \
    timm \
    pytorch-lightning \
    nltk \
    pypdf \
    gdown \
    librosa \
    flask-login \
    stripe \
    runpod \
    celery[redis] \
    redis \
    flask \
    flask-sqlalchemy \
    werkzeug \
    psutil

# Pré-télécharger les poids RF-DETR Medium (Apache 2.0)
RUN python3 -c "import rfdetr; rfdetr.RFDETRMedium()" || true
# Code PARSeq (lecture des numéros du montage joueur), même commit que analysis/montage_joueur_script.py ; les POIDS
# affinés (parseq_scoutia_maillots_v2.pt) sont à déposer sur le serveur → variable SCOUTIA_PARSEQ_POIDS
RUN python3 -c "import torch; torch.hub.load('baudm/parseq:1902db043c029a7e03a3818c616c06600af574be', 'parseq', pretrained=True, trust_repo=True)" || true

COPY runpod_worker.py /app/runpod_worker.py

CMD ["python3", "/app/runpod_worker.py"]
